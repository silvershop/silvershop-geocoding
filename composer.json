{
    "name": "silvershop/geocoding",
    "description": "Geocoding support for SilverShop: address and visitor-IP geocoding plus distance helpers.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "ecommerce", "shop", "geocoding", "address", "ip"],
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-geocoding/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.2",
        "silverstripe/framework": "^6",
        "silvershop/core": "^6",
        "willdurand/geocoder": "^5",
        "geocoder-php/chain-provider": "^4.1",
        "geocoder-php/nominatim-provider": "^5.8",
        "geocoder-php/google-maps-provider": "^4.8",
        "guzzlehttp/guzzle": "^7.0",
        "php-http/guzzle7-adapter": "^1.0 || ^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.7.2"
    },
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\Geocoding\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\Geocoding\\Tests\\": "tests/"
        }
    }
}
